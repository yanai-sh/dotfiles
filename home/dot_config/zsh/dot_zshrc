# Persistent, deduplicated history. XDG_* come from ~/.zshenv.
mkdir -p "$XDG_STATE_HOME/zsh" "$XDG_CACHE_HOME/zsh"
HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY

# Completion cache.
autoload -Uz compinit
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump"

# Interactive widgets require a real terminal-backed ZLE session.
if [[ -o zle && -t 0 && -t 1 ]]; then
  eval "$(zoxide init zsh)"
  source <(fzf --zsh)
fi
if [[ -t 0 && -t 1 && "${TERM:-dumb}" != dumb ]]; then
  eval "$(starship init zsh)"
fi

# Yazi cannot cd the parent shell. `y` writes the last dir and cds so
# zoxide's hook records it. `q` keeps the dir; `Q` leaves $PWD unchanged.
function y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || true
  command rm -f -- "$tmp"
}

alias ll='eza --long --all --group-directories-first --git --header --hyperlink'
alias lt='eza --tree --group-directories-first --header --hyperlink'
[[ -r ${ZDOTDIR}/.zshrc.local ]] && source ${ZDOTDIR}/.zshrc.local
