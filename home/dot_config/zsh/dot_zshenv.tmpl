# Tool data under the XDG directories instead of $HOME.
# CARGO_HOME and RUSTUP_HOME must be set before rustup installs into them.
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export npm_config_cache="$XDG_CACHE_HOME/npm"
export PYTHON_HISTORY="$XDG_STATE_HOME/python_history"
export NODE_REPL_HISTORY="$XDG_STATE_HOME/node_repl_history"

typeset -U path PATH
path=(
  "$HOME/.local/bin"
{{- if .isWSL }}
  "$HOME/.local/lib/win32"
{{- end }}
  "$CARGO_HOME/bin"
{{- if .isWSL }}
  {{/* Drop Windows /mnt entries. The win32 bridge above keeps the few Windows executables zsh should see. */}}
  ${path:#/mnt/*}
{{- else }}
  $path
{{- end }}
)
export PATH

export MANPAGER="bat -plman"
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/config"
export YAZI_CONFIG_HOME="$XDG_CONFIG_HOME/yazi"
{{- if .isWSL }}
case ":${_ZO_EXCLUDE_DIRS:-}:" in
  *:/mnt:*) ;;
  *) export _ZO_EXCLUDE_DIRS="/mnt${_ZO_EXCLUDE_DIRS:+:${_ZO_EXCLUDE_DIRS}}" ;;
esac
{{- end }}
export FZF_CTRL_T_COMMAND="fd --type f --type d --strip-cwd-prefix"
export FZF_ALT_C_COMMAND="fd --type d --strip-cwd-prefix"
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always {}'"
{{- if .isWSL }}
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wsl2-ssh-agent.sock"
{{- end }}
[[ -r ${ZDOTDIR}/.zshenv.local ]] && source ${ZDOTDIR}/.zshenv.local
