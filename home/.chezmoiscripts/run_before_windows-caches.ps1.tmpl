{{- if eq .chezmoi.os "windows" -}}
# Windows package caches. Runs on every apply, before files are written.
# Must stay Windows PowerShell 5.1 compatible: on a fresh install pwsh may
# not exist yet. Any D: counts; this does not detect a Dev Drive.
$ErrorActionPreference = 'Stop'

$caches = [ordered]@{
    NUGET_PACKAGES   = 'D:\cache\nuget'
    npm_config_cache = 'D:\cache\npm'
    CARGO_HOME       = 'D:\cache\cargo'
    PIP_CACHE_DIR    = 'D:\cache\pip'
}

function Set-UserEnvironmentVariable {
    param([string]$Name, [string]$Value)
    if ([Environment]::GetEnvironmentVariable($Name, 'User') -ne $Value) {
        Write-Host "user env $Name = $Value"
        [Environment]::SetEnvironmentVariable($Name, $Value, 'User')
    }
    Set-Item -Path "Env:$Name" -Value $Value
}

if (Test-Path -LiteralPath 'D:\') {
    foreach ($name in $caches.Keys) {
        New-Item -ItemType Directory -Force -Path $caches[$name] | Out-Null
        Set-UserEnvironmentVariable -Name $name -Value $caches[$name]
    }
}
else {
    foreach ($name in $caches.Keys) {
        $current = [Environment]::GetEnvironmentVariable($name, 'User')
        if ($current -like 'D:\cache\*') {
            Write-Host "remove user env $name"
            # NullString passes a real null. $null becomes an empty string and leaves the variable in place.
            [Environment]::SetEnvironmentVariable($name, [NullString]::Value, 'User')
            Remove-Item -Path "Env:$name" -ErrorAction SilentlyContinue
        }
    }
    Write-Host 'No D:\ drive.'
}
{{ end -}}
